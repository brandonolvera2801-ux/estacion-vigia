{
    printf("\n===== ESTACION VIGIA =====\n");
    printf("1. Capturar lecturas (buffer dinamico)     <- Fase 1\n");
    printf("2. Ver lecturas y estadisticas             <- Fase 1\n");
    printf("3. Ver registro de eventos/alertas         <- Fase 2\n");
    printf("4. Enviar comando al actuador (cola)       <- Fase 3\n");
    printf("5. Ejecutar comandos pendientes            <- Fase 3\n");
    printf("6. Deshacer ultimo comando (pila)          <- Fase 3\n");
    printf("0. Salir (libera toda la memoria)\n");
}

int main(void)
{
    Buffer       buffer;
    ListaEventos eventos;
    Cola         cola;
    Pila         pila;
    Actuador     actuador = {0, 0, 0};
    Umbrales     umbrales = {UMBRAL_ALTO, UMBRAL_BAJO};
    int          contador_cmd = 0;
    int          opcion = -1;

    srand((unsigned int)time(NULL));

    if (!buffer_crear(&buffer, CAP_INICIAL)) {
        fprintf(stderr, "Error: no se pudo reservar memoria para el buffer.\n");
        return EXIT_FAILURE;
    }
    eventos_iniciar(&eventos);
    cola_iniciar(&cola);
    pila_iniciar(&pila);

    while (opcion != 0) {
        mostrar_menu();
        if (!leer_entero("Opcion: ", 0, 6, &opcion))
            opcion = 0;                 /* EOF: salir limpiamente */

        switch (opcion) {
            case 1: opcion_capturar(&buffer, &eventos, &umbrales);          break;
            case 2: opcion_ver_lecturas(&buffer, &umbrales);                break;
            case 3: opcion_eventos(&eventos);                               break;
            case 4: opcion_enviar_comando(&cola, &contador_cmd, &actuador); break;
            case 5: opcion_ejecutar(&cola, &pila, &actuador);               break;
            case 6: opcion_deshacer(&pila, &actuador);                      break;
            default: break;
        }
    }

    /* Liberacion total de memoria */
    buffer_liberar(&buffer);
    eventos_vaciar(&eventos);
    cola_vaciar(&cola);
    pila_vaciar(&pila);

    printf("\nMemoria liberada. Fin del programa.\n");
    return EXIT_SUCCESS;
}
